﻿<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Student_registration</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Student_registration.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">Student_registration</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle text-dark" href="#" id="registrationDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                Registrations
                            </a>
                            <ul class="dropdown-menu" aria-labelledby="registrationDropdown">
                                <li>
                                    <h6 class="dropdown-header">Select Registration Type</h6>
                                </li>
                                <li>
                                    <a class="dropdown-item" asp-area="" asp-controller="Student" asp-action="Students">Student Registration</a>
                                </li>
                                <li>
                                    <a class="dropdown-item" asp-area="" asp-controller="Teacher" asp-action="Teachers">Teacher Registration</a>
                                </li>
                                <li>
                                    <a class="dropdown-item" asp-area="" asp-controller="Doctor" asp-action="Doctors">Doctor Registration</a>
                                </li>
                                <li>
                                    <a class="dropdown-item" asp-area="" asp-controller="Patient" asp-action="Patients">Patients Registration</a>
                                </li
                                 <li>
                                     <a class="dropdown-item" asp-area="" asp-controller="Account" asp-action="Rgister">Account Registration</a>
                                 </li>
                            </ul>
                        </li>
                    </ul>
                  
                </div>
                  <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                        <ul class="navbar-nav flex-grow-1">
    <li class="nav-item dropdown">
        <a class="nav-link dropdown-toggle text-dark" href="#" id="getdetailDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
            Get details
        </a>
        <ul class="dropdown-menu" aria-labelledby="getdetailDropdown">
            <li>
                <h6 class="dropdown-header">select type</h6>
            </li>
            <li>
                <a class="dropdown-item" asp-area="" asp-controller="Student" asp-action="GetStudents">GetStudents </a>
            </li>
            <li>
                <a class="dropdown-item" asp-area="" asp-controller="Teacher" asp-action="Getteachers">Get teachers</a>
            </li>
            <li>
                <a class="dropdown-item" asp-area="" asp-controller="Doctor" asp-action="GetDoctor">Get Doctor </a>
            </li>
            <li>
                <a class="dropdown-item" asp-area="" asp-controller="Patient" asp-action="getpatient">Get  Patients</a>
            </li>
        </ul>
    </li>
</ul>
    
  </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2024 - Student_registration - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>