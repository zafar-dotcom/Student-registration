<head>
    <style>
        body {
            font-family: Arial, sans-serif;
            margin: 0;
            padding: 0;
            background-color: #f4f4f4;
        }

        nav {
            background-color: #333;
            padding: 10px 20px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

            nav a {
                color: white;
                text-decoration: none;
                padding: 14px 20px;
                display: inline-block;
            }

                nav a:hover {
                    background-color: #575757;
                }

            nav ul {
                list-style: none;
                margin: 0;
                padding: 0;
                display: flex;
            }

                nav ul li {
                    position: relative;
                    display: inline;
                }

            nav button {
                background-color: #333;
                border: none;
                color: white;
                padding: 10px;
                cursor: pointer;
            }

                nav button:hover {
                    background-color: #575757;
                }

            nav form {
                display: flex;
                margin-left: auto;
            }

            nav input[type="search"] {
                padding: 6px;
                border: none;
                border-radius: 4px;
            }

            nav button[type="submit"] {
                padding: 6px 12px;
                border: none;
                background-color: #575757;
                color: white;
                border-radius: 4px;
                cursor: pointer;
                margin-left: 5px;
            }

                nav button[type="submit"]:hover {
                    background-color: #444;
                }

        ul ul {
            display: none;
            position: absolute;
            background-color: #333;
            padding: 10px 0;
            border-radius: 4px;
            top: 100%;
            left: 0;
            min-width: 160px;
            z-index: 1;
        }

        ul li:hover ul {
            display: block;
        }

        ul ul li {
            display: block;
            margin: 0;
            padding: 0;
        }

            ul ul li a {
                padding: 10px 20px;
                display: block;
                color: white;
            }

                ul ul li a:hover {
                    background-color: #575757;
                }

        hr {
            border: 0;
            height: 1px;
            background-color: #444;
        }
    </style>
</head>
<body>

    <nav>
        <div>
            <a href="#">Navbar</a>
            <button type="button">
                <span>☰</span>
            </button>
        </div>
        <div>
            <ul>
                <li>
                    <a href="#">Home</a>
                </li>
                <li>
                    <a href="#">Link</a>
                </li>
                <li>
                    <a href="#">Actions</a>
                    <ul>
                        <li><a href="#">Action</a></li>
                        <li><a href="#">Another action</a></li>
                        <li><hr></li>
                        <li><a href="#">Something else here</a></li>
                    </ul>
                </li>
                <li>
                    <a href="#" tabindex="-1">Disabled</a>
                </li>
            </ul>
        </div>
        <form>
            <input type="search" placeholder="Search">
            <button type="submit">Search</button>
        </form>
    </nav>

</body>
