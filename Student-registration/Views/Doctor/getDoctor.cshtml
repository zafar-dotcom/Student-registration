@model IEnumerable<Student_registration.Models.Doctors>
@{
    ViewData["Title"] = "Doctors";
}
@if (TempData["updated"] != null)
{
    <div class="alert alert-success">
        @TempData["updated"]
    </div>
}
@if (TempData["Deleted"] != null)
{
    <div class="alert alert-success">
        @TempData["Deleted"]
    </div>
}

<h2>Teachers</h2>

<p>
    @Html.ActionLink("Create New Doctor", "Doctor", null, new { @class = "btn btn-primary" })
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.FullName)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.FatherName)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Adress)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.City)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Phone)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Email)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Country)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Hospitalname)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @Html.DisplayFor(a => item.FullName)
                </td>
                <td>
                    @Html.DisplayFor(a => item.FatherName)
                </td>
                <td>
                    @Html.DisplayFor(a => item.Adress)
                </td>
                <td>
                    @Html.DisplayFor(a => item.City)
                </td>
                <td>
                    @Html.DisplayFor(a => item.Phone)
                </td>
                <td>
                    @Html.DisplayFor(a => item.Email)
                </td>
                <td>
                    @Html.DisplayFor(a => item.Country)
                </td>
                <td>
                    @Html.DisplayFor(a => item.Hospitalname)
                </td>
                <td>
                    @Html.ActionLink("UPDATE", "EditDoctor", new { DoctorId = item.DoctorId }, new { @class = "btn btn-primary" })
                    @Html.ActionLink("Delete", "Delete", new { DoctorId = item.DoctorId }, new { @class = "btn btn-primary" })

                   

                </td>
              
            </tr>
        }
    </tbody>
</table>

