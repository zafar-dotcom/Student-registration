@model IEnumerable<Student_registration.Models.Doctors>
@{
    ViewData["Title"] = "Doctors";
}

<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.FullName)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.FatherName)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Adress)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.City)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Phone)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Email)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Country)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Hospitalname)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @Html.DisplayFor(a => item.FullName)
                </td>
                <td>
                    @Html.DisplayFor(a => item.FatherName)
                </td>
                <td>
                    @Html.DisplayFor(a => item.Adress)
                </td>
                <td>
                    @Html.DisplayFor(a => item.City)
                </td>
                <td>
                    @Html.DisplayFor(a => item.Phone)
                </td>
                <td>
                    @Html.DisplayFor(a => item.Email)
                </td>
                <td>
                    @Html.DisplayFor(a => item.Country)
                </td>
                <td>
                    @Html.DisplayFor(a => item.Hospitalname)
                </td>
                <td>
                    
                </td>
            </tr>
        }
    </tbody>
</table>

