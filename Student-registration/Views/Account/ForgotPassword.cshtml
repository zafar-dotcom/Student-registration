@model Student_registration.Models.ForgotPassword

@{
    ViewData["Title"] = "Forgot Password";
}
@if (!string.IsNullOrEmpty(ViewBag.Message))
{
    <div class="alert alert-success">
        @ViewBag.Message
    </div>
}
<head>
    <link href="~/css/styles.css" rel="stylesheet" />
</head>
<div class="form-container">
<form asp-controller="Account" asp-action="ForgotPassword" method="Post">
<div class="form-group">
        <input type="text" name="Email" id="Email" asp-for="Email" placeholder="Enter Email Id" />
            <span asp-validation-for="Email" class="text-danger"></span>
</div>
        
        <button type="submit" class="btn btn-primary w-100">Send Password </button>
    </form>
</div>
