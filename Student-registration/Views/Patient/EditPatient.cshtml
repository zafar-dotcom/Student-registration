@model Student_registration.Models.Patient
@{
    ViewData["Title"] = "Edit Patient";
}

<h1>Edit Patient</h1>
<html>
<head>
    <title></title>
</head>
<body>
    <form asp-action="EditPatient">
        <div class="form-group">
            <label asp-for="FullName"> Full Name</label>
            <input type="text" asp-for="FullName" name="FullName" class="form-control" />
            <span asp-validation-for="FullName" class="text-danger"> </span>

        </div>
        <div class="form-group">
            <label asp-for="FatherName"> Father Name</label>
            <input type="text" asp-for="FatherName" name="FatherName" class="form-control" />
            <span asp-validation-for="FatherName" class="text-danger"> </span>

        </div>
        <div class="form-group">
            <label asp-for="BedNumber"> Bed Number</label>
            <input type="text" asp-for="BedNumber" name="BedNumber" class="form-control" />
            <span asp-validation-for="BedNumber" class="text-danger"> </span>

        </div>
        <div class="form-group">
            <label asp-for="Phone"> Phone</label>
            <input type="text" asp-for="Phone" name="Phone" class="form-control" />
            <span asp-validation-for="Phone" class="text-danger"> </span>

        </div>
        <div class="form-group">
            <label asp-for="City"> City</label>
            <input type="text" asp-for="City" name="City" class="form-control" />
            <span asp-validation-for="City" class="text-danger"> </span>

        </div>
        <div class="form-group">
            <label asp-for="Hospital">Hospital</label>
            <input type="text" asp-for="Hospital" name="Hospital" class="form-control" />
            <span asp-validation-for="Hospital" class="text-danger"> </span>

        </div>
        <div class="form-group">
            <label asp-for="DateOfBirth">DateOfBirth</label>
            <input type="text" asp-for="DateOfBirth" name="DateOfBirth" class="form-control" />
            <span asp-validation-for="DateOfBirth" class="text-danger"> </span>

        </div>
        <div class="form-group">
            <label asp-for="Address">Address</label>
            <input type="text" asp-for="Address" name="Address" class="form-control" />
            <span asp-validation-for="Address" class="text-danger"> </span>


        </div>
        <div class="form-group">
            <label asp-for="EmergencyContact"> Emergency Contact</label>
            <input type="text" asp-for="EmergencyContact" name="EmergencyContact" class="form-control" />
            <span asp-validation-for="EmergencyContact" class="text-danger"> </span>

        </div>
        <div class="form-group">
            <label asp-for="MedicalHistory"> Medical History</label>
            <input type="text" asp-for="MedicalHistory" name="MedicalHistory" class="form-control" />
            <span asp-validation-for="MedicalHistory" class="text-danger"> </span>

        </div>
        <div class="form-group">
            <label asp-for="BloodType">Blood Type</label>
            <input type="text" asp-for="BloodType" name="BloodType" class="form-control" />
            <span asp-validation-for="BloodType" class="text-danger"> </span>

        </div>
        <div class="form-group">
            <label asp-for="Allergies"> Allergies</label>
            <input type="text" asp-for="Allergies" name="Allergies" class="form-control" />
            <span asp-validation-for="Allergies" class="text-danger"> </span>

        </div>
        <input type="hidden" asp-for="PatientId" />
        <button type="submit"> Submit</button>
    </form>

</body>
</html>