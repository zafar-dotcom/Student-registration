@model IEnumerable<Student_registration.Models.Patient>
@{
    ViewData["Title"] = "Patient";
}
<head>
    <link href="~/css/styles.css" rel="stylesheet" />
</head>
@if (TempData["updated"] != null)
{
    <div class="alert alert-success">
        @TempData["updated"]
    </div>
}
@if (TempData["Deleted"] != null)
{
    <div class="alert alert-success">
        @TempData["Deleted"]
    </div>
}
<body>
    <div class="table-container">
<h2>Patient</h2>

<p style="margin-left:55px;">
    @Html.ActionLink("Create New Patient", "Patient", null, new { @class = "btn btn-primary" })
</p>
<table id="demoGrid" class="table table-striped table-bordered dt-responsive nowrap" width="100%" cellspacing="0">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.FullName)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.FatherName)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.BedNumber)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Phone)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.City)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Hospital)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.DateOfBirth)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Address)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.EmergencyContact)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.MedicalHistory)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.BloodType)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Allergies)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.FullName)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.FatherName)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.BedNumber)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Phone)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.City)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Hospital)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.DateOfBirth)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Address)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.EmergencyContact)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.MedicalHistory)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.BloodType)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Allergies)
                </td>
                <td>
                            <div class="action-links">
                                @Html.ActionLink("UPDATE", "EditPatient", new { PatientId = item.PatientId }, new { @class = "btn btn-primary" })
                                @Html.ActionLink("Delete", "Delete", new { PatientId = item.PatientId }, new { @class = "btn btn-primary" })
                            </div>s
                </td>
            </tr>
        }
    </tbody>
</table>
    </div>
</body>

