@model Student_registration.Models.Patient;

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Patient Registration Form</title>
    <link href="~/css/styles.css" rel="stylesheet" />
</head>
<body>
    <div class="container">
        <h2>Patient Registration Form</h2>
         @if (!string.IsNullOrEmpty(ViewBag.meassage))
        {
            <div class="alert alert-success">
                @ViewBag.meassage
            </div>
        }
        <form asp-action="Patients" method="post">
        <div class="form-group">
            <label for="fullname"> Full Name</label>
            <input type="text" id="fullname" class="fullname" asp-for="FullName">
            <span asp-validation-for="FullName"class="text-danger"></span>
        </div>
            <div class="form-group">
                <label for="fathername">Father Name</label>
                <input type="text" id="fathername" name="fathername" asp-for="FatherName" required>
                <span asp-validation-for="FatherName" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label for="bednumber">Bed Number</label>
                <input type="text" id="bednumber" name="bednumber" asp-for="BedNumber" required>
                <span asp-validation-for="BedNumber" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label for="phone">Phone:</label>
                <input type="text" id="phone" name="phone" asp-for="Phone">
                <span asp-validation-for="Phone" class="text-danger"></span>
            </div>

             <div class="form-group">
     <label for="city">City:</label>
     <input type="text" id="city" name="city" asp-for="City">
     <span asp-validation-for="City" class="text-danger"></span>
 </div>
          
          <div class="form-group">
  <label for="hospital">Hospital:</label>
  <input type="text" id="hosptal" name="hospital" asp-for="Hospital">
  <span asp-validation-for="Hospital" class="text-danger"></span>
</div>
        <div class="form-group">
<label for="dob">Date of birth:</label>
<input type="text" id="dob" name="date of birth" asp-for="DateOfBirth">
<span asp-validation-for="DateOfBirth" class="text-danger"></span>
  </div>>
    
             <div class="form-group">
                  <label for="adress">Address:</label>
                  <input type="text" id="adress" name="address" asp-for="Address">
                  <span asp-validation-for="Address" class="text-danger"></span>
              </div>
              <div class="form-group">
                  <label for="emergencycontact" >Emergencycontact:</label>
                  <input type="text"id="emegencycontat" name="emergencycontact" asp-for="EmergencyContact" />
                  <span asp-validation-for="EmergencyContact " class="text-danger"> </span>
              </div>
           <div class="form-group">
               <label for="medical history" > MedicalHistory</label>
               <input  type="medicalhistary" name="medicalhistory" asp-for="MedicalHistory"/>
               <span asp-validation-for="MedicalHistory" class="text-danger"> </span> 
           </div>
           <div class="form-group">
               <label for="bloodtype" >Blood Type </label>
               <input type="blood tye" name="bloodtype" asp-for="BloodType"/>
               <span asp-validation-for="BloodType" class="text-danger"> </span>
        
<div class="form-group">
    <label for="allergies" >Allergies </label>
    <input type="text" name="allergies" asp-for="Allergies"/>
    <span asp-validation-for="Allergies" class="text-danger"> </span>
</div>
            <button type="submit">Submit</button>
        </form>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/dist/jquery.validate.unobtrusive.min.js"></script>
</body>
</html>