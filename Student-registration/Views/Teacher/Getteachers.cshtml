@model IEnumerable<Student_registration.Models.teachermodel>
@{
    ViewData["Title"] = "teacher";
}
@if (TempData["updated"] != null)

{
    <div class="alert alert-success">
        @TempData["updated"]
    </div>
}
@if (TempData["Deleted"] != null)

{
    <div class="alert alert-success">
        @TempData["Deleted"]
    </div>
}
<p>
    @Html.ActionLink("Create New Teacher", "Teachers", null, new { @class = "btn btn-primary" })
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.FullName)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.FatherName)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Email)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Phone)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Dob)
            </th>
            <th>Edit</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @Html.DisplayFor(a => item.FullName)
                </td>
                <td>
                    @Html.DisplayFor(a => item.FatherName)
                </td>
                <td>
                    @Html.DisplayFor(a => item.Email)
                </td>
                <td>
                    @Html.DisplayFor(a => item.Phone)
                </td>
                <td>
                    @Html.DisplayFor(a => item.Dob)
                </td>
                <td>
                    @Html.ActionLink("UPDATE", "Edit", new { teacherid = item.teacherid }) |
                    @Html.ActionLink("Delete", "Delete", new { teacherid = item.teacherid }) |

                </td>
            </tr>
        }
    </tbody>
</table>

