@model IEnumerable<Student_registration.Models.teachermodel>
@{
    ViewData["Title"] = "teacher";
}
<head>
    <link href="~/css/styles.css" rel="stylesheet" />
</head>
@if (TempData["updated"] != null)

{
    <div class="alert alert-success">
        @TempData["updated"]
    </div>
}
@if (TempData["Deleted"] != null)

{
    <div class="alert alert-success">
        @TempData["Deleted"]
    </div>
}
<body>
<div class="table-container">
    <h2>Teachers </h2>
        <p style="margin-left:55px;">
    @Html.ActionLink("Create New Teacher", "Teachers", null, new { @class = "btn btn-primary" })
</p>
        <table id="demoGrid" class="table table-striped table-bordered dt-responsive nowrap" width="100%" cellspacing="0">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.FullName)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.FatherName)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Email)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Phone)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Dob)
            </th>
            <th>Edit</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @Html.DisplayFor(a => item.FullName)
                </td>
                <td>
                    @Html.DisplayFor(a => item.FatherName)
                </td>
                <td>
                    @Html.DisplayFor(a => item.Email)
                </td>
                <td>
                    @Html.DisplayFor(a => item.Phone)
                </td>
                <td>
                    @Html.DisplayFor(a => item.Dob)
                </td>
                        <td>
                            <div class="action-links">
                                @Html.ActionLink("Update", "EditDoctor", new { teacherid = item.teacherid }, new { @class = "btn btn-primary" })
                                <span class="separator">|</span>
                                @Html.ActionLink("Delete", "Delete", new { teacherid = item.teacherid }, new { @class = "bttnn btn-primary" })
                            </div>

                </td>
            </tr>
        }
    </tbody>
</table>
</div>
</body>
